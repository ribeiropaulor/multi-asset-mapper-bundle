{
    "name": "prr/multi-asset-mapper-bundle",
    "description": "This bundle extends the Symfony Asset Mapper component to allow managing multiple importmap files.",
     "keywords": [
        "symfony",
        "bundle"
    ],
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PRR\\MultiAssetMapperBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PRR\\MultiAssetMapperBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Paulo Ribeiro",
            "email": "paulo@prr.dev.br"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/asset-mapper": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit -c phpunit.xml.dist"
    }
}
